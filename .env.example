# Supabase — cloud project (dev runs against the cloud project, no Docker)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Upstash Redis (rate limiting). Leave empty to disable in local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (OAuth redirects and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anonymous publishing (all optional locally, set them in production)
# Cloudflare Turnstile captcha. Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared secret that forces submissions through the server actions. Must match the
# 'submit_gate' row in private_settings (see README). Leave empty to leave the gate open.
SUBMIT_GATE_SECRET=
# Resend, used to email the private edit link. Leave empty to only show it on screen.
RESEND_API_KEY=
EMAIL_FROM=Lloguer <no-reply@your-domain>
# Show the demo email/password login form in production (dev always shows it)
ENABLE_EMAIL_LOGIN=
